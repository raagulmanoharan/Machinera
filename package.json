{
  "name": "little-zine",
  "description": "A private photo and video journal, one page at a time.",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "base64-js": "^1.5.1",
    "buffer": "^6.0.3",
    "expo": "~57.0.27",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "native:ios": "expo prebuild --platform ios --no-install",
    "start:go": "expo start --go",
    "testflight:build": "npx --yes eas-cli@latest build --platform ios --profile testflight",
    "testflight:submit": "npx --yes eas-cli@latest submit --platform ios --profile testflight --latest",
    "start:native": "expo start --dev-client"
  },
  "type": "module"
}
