# Machinera runs fully offline by default (procedural imagination + local faculty).
# It is a static site, so these are NEXT_PUBLIC_ and are readable in the browser.
# Nothing here is required.

# --- Imagination: real image generation ---
# By default the Imagination generates REAL images with no key (FLUX via
# Pollinations). Options:
#   auto        (default) real generation once the mind has learned something
#   procedural  force the offline SVG-abstraction look
#   pollinations always use the keyless FLUX endpoint
NEXT_PUBLIC_IMAGINATION=auto
# Optional: override the keyless image host / route images through the sidecar.
# NEXT_PUBLIC_POLLINATIONS_BASE=https://image.pollinations.ai
# POLLINATIONS_BASE=https://image.pollinations.ai   # (sidecar-side, for /image)

# --- Imagination: Z-Image Turbo (bring your own endpoint) ---
# When set, the Imagination hands off to this endpoint once the mind is mature
# enough to render real forms. Below the threshold it always stays procedural.
# Note: on a purely static host the browser calls this directly, so the endpoint
# must allow CORS and any key here is public. For a private key, put a small
# proxy/server in front and point NEXT_PUBLIC_ZIMAGE_ENDPOINT at it.
NEXT_PUBLIC_ZIMAGE_ENDPOINT=
NEXT_PUBLIC_ZIMAGE_API_KEY=
# Maturity (0..1) at which real image generation switches on. Newborn stays abstract.
NEXT_PUBLIC_IMAGINATION_HANDOFF=0.35

# --- Mind: real LLM faculty via the sidecar ---
# Front-end: when set, the app calls the sidecar for the reasoning faculty
# instead of the built-in local one. Leave blank to stay fully local/offline.
NEXT_PUBLIC_SIDECAR_URL=
#
# Sidecar service (server-side; NOT exposed to the browser). Pick a provider:
#   - default: the local authenticated `claude` CLI (no key needed in this env)
#   - Anthropic: set ANTHROPIC_API_KEY
#   - OpenAI-compatible: set OPENAI_API_KEY (+ SIDECAR_OPENAI_BASE for a custom base)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# SIDECAR_OPENAI_BASE=https://api.openai.com/v1
# SIDECAR_MODEL=claude-haiku-4-5-20251001
# SIDECAR_ALLOW_ORIGIN=*          # tighten to your site's origin in production
# PORT=8787

# --- Deployment ---
# Set automatically by the GitHub Pages workflow to "/<repo>". Leave blank for
# local dev so the site serves from the root.
NEXT_PUBLIC_BASE_PATH=
