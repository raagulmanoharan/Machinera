# Machinera runs fully offline by default (procedural imagination + local faculty).
# It is a static site, so these are NEXT_PUBLIC_ and are readable in the browser.
# Nothing here is required.

# --- Imagination: Z-Image Turbo (or any compatible text-to-image endpoint) ---
# When set, the Imagination hands off to this endpoint once the mind is mature
# enough to render real forms. Below the threshold it always stays procedural.
# Note: on a purely static host the browser calls this directly, so the endpoint
# must allow CORS and any key here is public. For a private key, put a small
# proxy/server in front and point NEXT_PUBLIC_ZIMAGE_ENDPOINT at it.
NEXT_PUBLIC_ZIMAGE_ENDPOINT=
NEXT_PUBLIC_ZIMAGE_API_KEY=
# Maturity (0..1) at which real image generation switches on. Newborn stays abstract.
NEXT_PUBLIC_IMAGINATION_HANDOFF=0.35

# --- Deployment ---
# Set automatically by the GitHub Pages workflow to "/<repo>". Leave blank for
# local dev so the site serves from the root.
NEXT_PUBLIC_BASE_PATH=
